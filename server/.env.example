# Server Environment Variables
# Copy this file to .env and fill in your values

# ── Google Gemini (Required) ──────────────────
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# ── Redis (Required) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── MongoDB (Required for Trade Journal) ─────
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=optionsmart_chat

# ── Zerodha Kite (Optional - for live data) ──
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ── Server ───────────────────────────────────
PORT=8001
FRONTEND_URL=http://localhost:5174

# ── Embedding provider ───────────────────────
# 'local'  → uses @xenova/transformers (free, downloads ~25MB model on first run)
# 'openai' → uses text-embedding-3-small (needs OPENAI_API_KEY below)
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# ── Web Scraping (for daily knowledge refresh) ───────
# Comma-separated list of websites to crawl at midnight each day.
# The scraper follows all same-domain internal links (up to 60 pages total).
SCRAPE_URLS=https://optionsmart.in,https://goalgotrade.tech
