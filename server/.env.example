# Server Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.

# ── Gemini (Required) ─────────────────────
GEMINI_API_KEY=your_google_ai_studio_key_here

# ── Redis (Required) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── MongoDB (Required for Trade Journal) ─────
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=optionsmart_chat

# ── Zerodha Kite (Optional - for live data) ──
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
# Paste your Kite access token here (valid for one day — regenerate each morning)
ZERODHA_ACCESS_TOKEN=

# ── Server ───────────────────────────────────
PORT=8001
FRONTEND_URL=http://localhost:5174

# ── Embedding provider ───────────────────────
# 'local'  → uses @xenova/transformers (free, downloads ~25MB model on first run)
# 'openai' → uses text-embedding-3-small (needs OPENAI_API_KEY below)
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# ── Web Scraping (for daily knowledge refresh) ───────
SCRAPE_URLS=https://optionsmart.in,https://goalgotrade.tech

# ── Gemini Model (Optional) ──────────────────
# Defaults to gemini-1.5-flash. Change to gemini-1.5-pro for higher quality.
GEMINI_MODEL=gemini-1.5-flash
