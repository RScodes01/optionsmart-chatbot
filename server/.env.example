# Server Environment Variables
# Copy this file to .env and fill in your values

# ── Anthropic (Required) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-PASTE_YOUR_KEY_HERE

# ── Redis (Required) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── MongoDB (Required for Trade Journal) ─────
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=optionsmart_chat

# ── Zerodha Kite (Optional - for live data) ──
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ── Server ───────────────────────────────────
PORT=8001
FRONTEND_URL=http://localhost:5174

# ── Embedding provider ───────────────────────
# 'local'  → uses @xenova/transformers (free, downloads ~25MB model on first run)
# 'openai' → uses text-embedding-3-small (needs OPENAI_API_KEY below)
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
